# Шаблон. Заполни .env и не коммить его в репозиторий.
# IMAP / SMTP — Яндекс 360
YANDEX_LOGIN=name@example.ru
YANDEX_APP_PASSWORD=__password_for_IMAP_SMTP__
IMAP_HOST=imap.yandex.ru
IMAP_PORT=993
IMAP_FOLDER=Hronos_torfa
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
# при необходимости SMTP-логин/пароль отличаются — иначе берётся YANDEX_LOGIN/YANDEX_APP_PASSWORD
SMTP_LOGIN=
SMTP_PASSWORD=

# Telegram-бот @alexeids_bot
BOT_TOKEN=__telegram_bot_token__
# Список разрешённых tg user_id через запятую. Если пусто — берётся первый, кто написал /start
BOT_ADMINS=
# Заполняется автоматически после /start, но можно прописать руками
BOT_ADMIN_CHAT_ID=
